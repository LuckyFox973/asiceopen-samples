# ---------------------------------------------------------------------------
# Email AI Assistant — example environment file
# Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development                  # development | staging | production
LOG_LEVEL=INFO
TIMEZONE=Europe/Bratislava

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://eaa:devpassword@127.0.0.1:5432/email_assistant
TEST_DATABASE_URL=postgresql+psycopg://eaa:devpassword@127.0.0.1:5432/email_assistant_test

# --- Encryption ------------------------------------------------------------
# Fernet key protecting OAuth refresh tokens at rest.
# Generate:  python -m app.core.crypto keygen
# In production this comes from Google Secret Manager, not from .env.
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth ----------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Sync defaults ---------------------------------------------------------
# Gmail messages older than this date are never fetched (ISO-8601, date only).
SYNC_START_DATE=2026-09-01
SYNC_PAGE_SIZE=100
SYNC_MAX_MESSAGES_PER_RUN=2000

# --- Attachment storage ----------------------------------------------------
# local  -> ATTACHMENT_LOCAL_PATH
# gcs    -> ATTACHMENT_GCS_BUCKET (production)
ATTACHMENT_BACKEND=local
ATTACHMENT_LOCAL_PATH=./data/attachments
ATTACHMENT_GCS_BUCKET=
ATTACHMENT_MAX_BYTES=26214400        # 25 MiB — skip download above this

# --- API authentication ----------------------------------------------------
# Callers send: Authorization: Bearer <key>
# Off by default in development only; always required outside it.
# Issue a key with: python -m app.cli api-key create <name>
API_AUTH_ENABLED=false

# --- Backups ---------------------------------------------------------------
# Archives are ALWAYS encrypted before they leave this machine.  A dump of this
# database contains every stored message, so there is no unencrypted option.
BACKUP_ENABLED=false
BACKUP_BACKEND=local                 # local | gdrive
BACKUP_LOCAL_PATH=./data/backups
BACKUP_GDRIVE_FOLDER=EmailAssistantBackups

# Generate:  python -m app.core.crypto keygen
# Keep this OFF the Drive you back up to — a key stored beside the archive
# protects nothing.  Deliberately separate from TOKEN_ENCRYPTION_KEY so a
# restore can be handed to someone without also handing over live mailbox
# credentials.
BACKUP_ENCRYPTION_KEY=

BACKUP_RETENTION=14                  # archives to keep; older ones are deleted
BACKUP_INCLUDE_ATTACHMENTS=false     # attachment bytes are re-fetchable from Gmail
BACKUP_ACCOUNT_EMAIL=                # which mailbox's Google account owns the Drive folder

# --- Local scheduler -------------------------------------------------------
# Used by: python -m app.cli daemon
SCHEDULER_SYNC_INTERVAL_MINUTES=15
SCHEDULER_BACKUP_HOUR=3              # local hour (TIMEZONE) for the daily backup
EXTRACT_BATCH_SIZE=50                # attachments parsed per cycle

# --- Internal job auth -----------------------------------------------------
# Shared secret for /api/v1/jobs/* endpoints called by Cloud Scheduler.
# Leave empty in development to disable the check.
JOB_AUTH_TOKEN=
