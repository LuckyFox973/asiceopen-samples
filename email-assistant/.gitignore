# Secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
client_secret*.json
service-account*.json
credentials.json
token.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# Local data
/data/
/tmp/
*.sqlite3
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store

# Scratch output. Rasterising a page with pdftoppm and no output root writes
# beside the process; one such file reached a commit before this line existed.
/-.png
/*.ppm
/*.pgm
/page-*.png
